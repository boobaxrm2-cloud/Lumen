PORT=3000

# Chave usada para criptografar o cookie de sessao.
# Troque por qualquer texto longo e aleatorio no seu .env real.
SESSION_SECRET=troque-esta-chave-por-algo-aleatorio-e-secreto

# Opcional: chave gratuita da API do Semantic Scholar, usada na busca de artigos.
# Sem ela, a busca funciona normalmente, mas divide o limite de requisicoes com
# qualquer pessoa no mundo usando a API sem chave (por isso o erro "Muitas buscas
# em pouco tempo" pode aparecer com mais frequencia). Com a chave, voce tem uma
# cota so sua. Peça a sua em: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# Email da conta que deve ter acesso ao painel administrativo (/admin).
# Precisa ser o email de uma conta ja cadastrada na plataforma - o login e o
# mesmo de sempre (email + senha), sem usuario/senha separados pro admin.
ADMIN_EMAIL=
