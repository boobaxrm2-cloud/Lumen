<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <title><%= t('messages.tabTitle') %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="corpo-app">
    <%- include('partials/barra-lateral', { paginaAtiva: 'mensagens' }) %>

    <main>
    <%- include('partials/voltar-modulos') %>
    <p class="eyebrow-secao"><%= t('messages.eyebrow') %></p>
    <h2><%= t('messages.heading') %></h2>
    <p class="subtitulo-documentos" style="margin-bottom: 1.3rem;"><%= t('messages.subtitle') %></p>

    <% if (conversas.length === 0) { %>
      <p class="lista-vazia"><%= t('messages.emptyConversations') %></p>
    <% } else { %>
      <div class="lista-documentos-codificar">
        <% conversas.forEach(function (conversa) { %>
          <a class="documento-codificar-card" href="/mensagens/<%= conversa.outro_id %>">
            <% if (conversa.outro_avatar) { %>
              <img class="avatar-preview avatar-preview-pequeno" src="/usuarios/<%= conversa.outro_id %>/foto" alt="<%= conversa.outro_nome %>" />
            <% } else { %>
              <span class="avatar-preview avatar-preview-pequeno avatar-preview-vazio">
                <svg class="icone" viewBox="0 0 24 24"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 10.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-5.5"/></svg>
              </span>
            <% } %>
            <span class="documento-codificar-info">
              <strong><%= conversa.outro_nome %></strong>
              <span><%= conversa.ultima_mensagem.length > 80 ? conversa.ultima_mensagem.slice(0, 80) + '…' : conversa.ultima_mensagem %></span>
            </span>
            <% if (conversa.nao_lidas > 0) { %><span class="badge-notificacao"><%= conversa.nao_lidas %></span><% } %>
            <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        <% }); %>
      </div>
    <% } %>
    </main>
  </div>
</body>
</html>
