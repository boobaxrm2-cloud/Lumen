<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <title><%= t('signup.tabTitle') %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-tela">
    <div class="ficha-auth">
      <div class="seletor-idioma-auth">
        <%- include('partials/seletor-idioma') %>
      </div>
      <h1 class="auth-logo-titulo"><img class="auth-logo" src="/images/logo-lumen.png" alt="Lumen" /></h1>
      <p class="subtitulo"><%= t('signup.subtitle') %></p>

      <% if (erro) { %>
        <div class="erro"><%= erro %></div>
      <% } %>

      <form method="POST" action="/cadastro">
        <div class="campo">
          <label for="name"><%= t('signup.nameLabel') %></label>
          <input type="text" id="name" name="name" value="<%= valores.name %>" placeholder="<%= t('signup.namePlaceholder') %>" required autofocus />
        </div>
        <div class="campo">
          <label for="email"><%= t('signup.emailLabel') %></label>
          <input type="email" id="email" name="email" value="<%= valores.email %>" required />
        </div>
        <div class="campo">
          <label for="password"><%= t('signup.passwordLabel') %></label>
          <input type="password" id="password" name="password" minlength="6" required />
        </div>
        <div class="campo">
          <label for="confirmarSenha"><%= t('signup.confirmPasswordLabel') %></label>
          <input type="password" id="confirmarSenha" name="confirmarSenha" minlength="6" required />
        </div>
        <div class="campo">
          <label for="secretQuestion"><%= t('signup.secretQuestionLabel') %></label>
          <select id="secretQuestion" name="secretQuestion" required>
            <option value="" disabled selected><%= t('signup.secretQuestionPlaceholder') %></option>
            <option value="motherMaidenName"><%= t('secretQuestion.motherMaidenName') %></option>
            <option value="firstPet"><%= t('secretQuestion.firstPet') %></option>
            <option value="birthCity"><%= t('secretQuestion.birthCity') %></option>
            <option value="firstSchool"><%= t('secretQuestion.firstSchool') %></option>
            <option value="favoriteFood"><%= t('secretQuestion.favoriteFood') %></option>
          </select>
        </div>
        <div class="campo">
          <label for="secretAnswer"><%= t('signup.secretAnswerLabel') %></label>
          <input type="text" id="secretAnswer" name="secretAnswer" required />
        </div>
        <button class="botao acao-larga" type="submit"><%= t('signup.submitButton') %></button>
      </form>

      <p class="rodape-ficha"><%= t('signup.hasAccount') %> <a href="/login"><%= t('signup.loginLink') %></a></p>
    </div>
  </div>
</body>
</html>
