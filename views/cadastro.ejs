<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Criar conta — Codex</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-tela">
    <div class="ficha-auth">
      <h1>Nova ficha</h1>
      <p class="subtitulo">Crie sua conta de pesquisador para começar.</p>

      <% if (erro) { %>
        <div class="erro"><%= erro %></div>
      <% } %>

      <form method="POST" action="/cadastro">
        <div class="campo">
          <label for="name">Nome</label>
          <input type="text" id="name" name="name" value="<%= valores.name %>" required autofocus />
        </div>
        <div class="campo">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= valores.email %>" required />
        </div>
        <div class="campo">
          <label for="password">Senha</label>
          <input type="password" id="password" name="password" minlength="6" required />
        </div>
        <button class="botao acao-larga" type="submit">Criar conta</button>
      </form>

      <p class="rodape-ficha">Já tem conta? <a href="/login">Entrar</a></p>
    </div>
  </div>
</body>
</html>
