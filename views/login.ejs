<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Entrar — Lumen</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-tela">
    <div class="ficha-auth">
      <h1><svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg> Lumen</h1>
      <p class="subtitulo">Catálogo pessoal de pesquisa: artigos, leituras e codificação.</p>

      <% if (erro) { %>
        <div class="erro"><%= erro %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="campo">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= valores.email %>" required autofocus />
        </div>
        <div class="campo">
          <label for="password">Senha</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button class="botao acao-larga" type="submit">Entrar</button>
      </form>

      <p class="rodape-ficha">Ainda não tem conta? <a href="/cadastro">Cadastre-se</a></p>
    </div>
  </div>
</body>
</html>
