<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <title><%= t('articles.tabTitle') %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/cabecalho') %>

  <div class="corpo-app">
    <%- include('partials/barra-lateral', { paginaAtiva: 'artigos' }) %>

    <main>
    <%- include('partials/voltar-modulos') %>
    <h2><%= t('articles.heading') %></h2>
    <form class="busca-form" id="form-busca">
      <input type="text" id="campo-busca" value="<%= queryInicial %>" placeholder="<%= t('articles.searchPlaceholder') %>" autofocus />
      <button class="botao" type="submit"><%= t('articles.searchButton') %></button>
    </form>
    <p class="aviso-busca" id="aviso-busca"></p>

    <div class="busca-layout">
      <aside class="filtros-busca">
        <div class="filtros-cabecalho">
          <h3><%= t('articles.filtersHeading') %></h3>
          <button type="button" id="botao-limpar-filtros" class="link-limpar"><%= t('articles.clearAll') %></button>
        </div>

        <div class="filtro-grupo">
          <h4><%= t('articles.yearHeading') %></h4>
          <div class="filtro-ano-intervalo">
            <input type="number" id="filtro-ano-de" placeholder="<%= t('articles.yearFrom') %>" min="1900" max="2100" />
            <span>–</span>
            <input type="number" id="filtro-ano-ate" placeholder="<%= t('articles.yearTo') %>" min="1900" max="2100" />
          </div>
        </div>

        <div class="filtro-grupo">
          <h4><%= t('articles.typeHeading') %></h4>
          <label><input type="checkbox" class="filtro-tipo" value="JournalArticle" /> <%= t('articles.typeJournalArticle') %></label>
          <label><input type="checkbox" class="filtro-tipo" value="Conference" /> <%= t('articles.typeConference') %></label>
          <label><input type="checkbox" class="filtro-tipo" value="Review" /> <%= t('articles.typeReview') %></label>
          <label><input type="checkbox" class="filtro-tipo" value="Book" /> <%= t('articles.typeBook') %></label>
          <label><input type="checkbox" class="filtro-tipo" value="BookSection" /> <%= t('articles.typeBookSection') %></label>
          <label><input type="checkbox" class="filtro-tipo" value="CaseReport" /> <%= t('articles.typeCaseReport') %></label>
        </div>

        <button type="button" class="botao acao-larga" id="botao-aplicar-filtros"><%= t('articles.applyFilters') %></button>
      </aside>

      <section class="resultados-area">
        <div class="resultados-cabecalho">
          <span id="contagem-resultados" class="contagem"></span>
          <div class="resultados-controles">
            <label class="controle-ordenar">
              <%= t('articles.sortBy') %>
              <select id="select-ordenar">
                <option value="relevancia"><%= t('articles.sortRelevance') %></option>
                <option value="recente"><%= t('articles.sortRecent') %></option>
              </select>
            </label>
            <div class="alternar-visual">
              <button type="button" class="botao-visual ativo" data-visual="grade" id="botao-visual-grade"><%= t('articles.viewGrid') %></button>
              <button type="button" class="botao-visual" data-visual="lista" id="botao-visual-lista"><%= t('articles.viewList') %></button>
            </div>
          </div>
        </div>

        <div class="grade-fichas" id="resultados"></div>
        <div class="acoes-painel" id="area-carregar-mais" style="display: none; margin-top: 1.5rem; justify-content: center;">
          <button class="botao secundario" type="button" id="botao-carregar-mais"><%= t('articles.loadMore') %></button>
        </div>
      </section>
    </div>
    </main>
  </div>

  <%- include('partials/modal-pdf') %>

  <script>
    window.I18N_ARTIGOS = <%- JSON.stringify({
      searching: t('articles.searching'),
      errorGeneric: t('articles.errorGeneric'),
      noResults: t('articles.noResults'),
      resultCount: t('articles.resultCount'),
      connectionError: t('articles.connectionError'),
      openArticleLink: t('articles.openArticleLink'),
      previewButton: t('articles.previewButton'),
      downloadPdfButton: t('articles.downloadPdfButton'),
      alreadySavedTitle: t('articles.alreadySavedTitle'),
      alreadySavedButton: t('articles.alreadySavedButton'),
      saveButton: t('articles.saveButton'),
      discardButton: t('articles.discardButton'),
      savingButton: t('articles.savingButton'),
      saveErrorGeneric: t('articles.saveErrorGeneric'),
      saveConnectionError: t('articles.saveConnectionError'),
      savedButton: t('articles.savedButton'),
    }) %>;
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="/js/pdf-preview.js"></script>
  <script src="/js/artigos.js"></script>
</body>
</html>
