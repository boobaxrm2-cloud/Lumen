<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Artigos — Lumen</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/topo', { userName: userName || '', paginaAtiva: 'artigos' }) %>

  <main>
    <%- include('partials/voltar-modulos') %>
    <h2>Buscar artigos</h2>
    <form class="busca-form" id="form-busca">
      <input type="text" id="campo-busca" value="<%= queryInicial %>" placeholder="Ex: alfabetização, ensino híbrido, avaliação formativa..." autofocus />
      <button class="botao" type="submit">Buscar</button>
    </form>
    <p class="aviso-busca" id="aviso-busca"></p>

    <section class="secao">
      <h2>Resultados</h2>
      <div class="grade-fichas" id="resultados"></div>
      <div class="acoes-painel" id="area-carregar-mais" style="display: none; margin-top: 1.5rem; justify-content: center;">
        <button class="botao secundario" type="button" id="botao-carregar-mais">Carregar mais resultados</button>
      </div>
    </section>
  </main>

  <%- include('partials/modal-pdf') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="/js/pdf-preview.js"></script>
  <script src="/js/artigos.js"></script>
</body>
</html>
