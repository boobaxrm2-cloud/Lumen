<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <title>Lumen</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="corpo-app">
    <%- include('partials/barra-lateral', { paginaAtiva: 'inicio' }) %>

    <main>
    <div class="hero">
      <div class="hero-imagem-fundo" style="background-image: url('/images/hero-lumen.png');"></div>
      <div class="hero-conteudo">
        <p class="eyebrow"><%= t('home.hero.eyebrow') %></p>
        <h1><%= t('home.hero.welcomePrefix') %><span class="destaque-dourado"><%= userName %></span></h1>
        <p><%= t('home.hero.subtitle') %></p>
        <ul class="hero-destaques">
          <li>
            <span class="icone-circulo">
              <svg class="icone" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
            </span>
            <%= t('home.hero.highlight1') %>
          </li>
          <li>
            <span class="icone-circulo">
              <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/></svg>
            </span>
            <%= t('home.hero.highlight2') %>
          </li>
          <li>
            <span class="icone-circulo">
              <svg class="icone" viewBox="0 0 24 24"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg>
            </span>
            <%= t('home.hero.highlight3') %>
          </li>
        </ul>
      </div>
    </div>

    <section class="secao-modulos">
      <div class="secao-modulos-cabecalho">
        <div class="titulo-com-icone">
          <span class="icone-caixa">
            <svg class="icone" viewBox="0 0 24 24"><path d="M4 5c3-1.3 6-1.3 8 0 2-1.3 5-1.3 8 0v14c-3-1.3-6-1.3-8 0-2-1.3-5-1.3-8 0z"/><path d="M12 5v14"/></svg>
          </span>
          <div>
            <h2><%= t('home.modules.heading') %></h2>
            <p><%= t('home.modules.subtitle') %></p>
          </div>
        </div>
        <div class="controles-modulos">
          <label class="busca-catalogo busca-modulos">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input type="search" id="busca-modulos" placeholder="<%= t('home.modules.searchPlaceholder') %>" />
          </label>
          <select class="controle-ordenar-select" id="ordenar-modulos">
            <option><%= t('home.modules.sortMostRecent') %></option>
          </select>
        </div>
      </div>

      <div class="linha-modulo" data-titulo-modulo="<%= t('home.moduleArticles.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/modulo-busca.jpg');"></div>
          <span class="selo-flutuante"><%= t('home.badge.available') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleArticles.eyebrow') %>
          </p>
          <h3><%= t('home.moduleArticles.title') %></h3>
          <p class="descricao"><%= t('home.moduleArticles.description') %></p>
          <a class="botao" href="/artigos">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <%= t('home.moduleArticles.cta') %>
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleArticles.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleArticles.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleArticles.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleArticles.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>

      <div class="linha-modulo" data-titulo-modulo="<%= t('home.moduleReading.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/modulo-leitura.jpg');"></div>
          <span class="selo-flutuante"><%= t('home.badge.available') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleReading.eyebrow') %>
          </p>
          <h3><%= t('home.moduleReading.title') %></h3>
          <p class="descricao"><%= t('home.moduleReading.description') %></p>
          <a class="botao" href="/leitura">
            <svg class="icone" viewBox="0 0 24 24"><path d="M4 5c3-1.3 6-1.3 8 0 2-1.3 5-1.3 8 0v14c-3-1.3-6-1.3-8 0-2-1.3-5-1.3-8 0z"/><path d="M12 5v14"/></svg>
            <%= t('home.moduleReading.cta') %>
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleReading.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleReading.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleReading.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleReading.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>

      <div class="linha-modulo" data-titulo-modulo="<%= t('home.moduleCoding.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/modulo-codificacao.jpg');"></div>
          <span class="selo-flutuante"><%= t('home.badge.available') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleCoding.eyebrow') %>
          </p>
          <h3><%= t('home.moduleCoding.title') %></h3>
          <p class="descricao"><%= t('home.moduleCoding.description') %></p>
          <a class="botao" href="/codificacao">
            <svg class="icone" viewBox="0 0 24 24"><path d="M20.59 13.41L11 3.83A2 2 0 009.59 3H4a1 1 0 00-1 1v5.59a2 2 0 00.59 1.41l9.58 9.58a2 2 0 002.83 0l4.59-4.59a2 2 0 000-2.83z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            <%= t('home.moduleCoding.cta') %>
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleCoding.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleCoding.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleCoding.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleCoding.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>

      <div class="linha-modulo" data-titulo-modulo="<%= t('home.moduleLibrary.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/livraria.PNG');"></div>
          <span class="selo-flutuante"><%= t('home.badge.available') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleLibrary.eyebrow') %>
          </p>
          <h3><%= t('home.moduleLibrary.title') %></h3>
          <p class="descricao"><%= t('home.moduleLibrary.description') %></p>
          <a class="botao" href="/biblioteca">
            <svg class="icone" viewBox="0 0 24 24"><path d="M4 4v16M9 4v16M9 4c2 0 3 1 5 1s3-1 5-1v14c-2 0-3 1-5 1s-3-1-5-1"/></svg>
            <%= t('home.moduleLibrary.cta') %>
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleLibrary.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleLibrary.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleLibrary.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleLibrary.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>

      <div class="linha-modulo" data-titulo-modulo="<%= t('home.moduleForum.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/modulo-forum.jpg');"></div>
          <span class="selo-flutuante"><%= t('home.badge.available') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleForum.eyebrow') %>
          </p>
          <h3><%= t('home.moduleForum.title') %></h3>
          <p class="descricao"><%= t('home.moduleForum.description') %></p>
          <a class="botao" href="/forum">
            <svg class="icone" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            <%= t('home.moduleForum.cta') %>
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForum.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForum.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForum.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForum.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>

      <div class="linha-modulo" data-titulo-modulo="<%= t('home.moduleForms.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/modulo-formularios.jpg');"></div>
          <span class="selo-flutuante"><%= t('home.badge.available') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleForms.eyebrow') %>
          </p>
          <h3><%= t('home.moduleForms.title') %></h3>
          <p class="descricao"><%= t('home.moduleForms.description') %></p>
          <a class="botao" href="/formularios">
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 3h6a2 2 0 012 2v14a2 2 0 01-2 2H9a2 2 0 01-2-2V5a2 2 0 012-2z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
            <%= t('home.moduleForms.cta') %>
            <svg class="icone" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForms.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForms.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForms.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleForms.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>

      <div class="linha-modulo em-breve" data-titulo-modulo="<%= t('home.moduleQuantitative.title') %>">
        <div class="miniatura-caixa">
          <div class="miniatura" style="background-image: url('/images/modulo-quantitativa.jpg');"></div>
          <div class="miniatura-bloqueio">
            <svg class="icone" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
          </div>
          <span class="selo-flutuante em-breve"><%= t('home.badge.comingSoon') %></span>
        </div>
        <div>
          <p class="eyebrow-modulo">
            <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <%= t('home.moduleQuantitative.eyebrow') %>
          </p>
          <h3><%= t('home.moduleQuantitative.title') %></h3>
          <p class="descricao"><%= t('home.moduleQuantitative.description') %></p>
        </div>
        <ul class="lista-recursos">
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleQuantitative.feature1') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleQuantitative.feature2') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleQuantitative.feature3') %></li>
          <li><span class="icone-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></span> <%= t('home.moduleQuantitative.feature4') %></li>
        </ul>
        <svg class="icone seta-linha" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </div>
    </section>
    </main>
  </div>

  <script>
    (function () {
      var busca = document.getElementById('busca-modulos');
      if (!busca) return;
      busca.addEventListener('input', function () {
        var termo = busca.value.trim().toLowerCase();
        document.querySelectorAll('.linha-modulo').forEach(function (linha) {
          var titulo = (linha.getAttribute('data-titulo-modulo') || '').toLowerCase();
          linha.style.display = titulo.includes(termo) ? '' : 'none';
        });
      });
    })();
  </script>
</body>
</html>
