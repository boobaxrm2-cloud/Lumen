<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <title><%= t('library.tabTitle') %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/cabecalho') %>

  <div class="corpo-app">
    <%- include('partials/barra-lateral', { paginaAtiva: 'biblioteca' }) %>

    <main>
    <%- include('partials/voltar-modulos') %>
    <section class="secao">
      <h2>
        <%= t('library.heading') %>
        <span class="contagem"><%= t('library.itemCount', { n: salvos.length }) %></span>
      </h2>
      <div class="acoes-painel" style="margin-bottom: 1.5rem;">
        <a class="botao secundario" href="/artigos/exportar.csv"><%= t('library.exportCsv') %></a>
        <a class="botao secundario" href="/artigos"><%= t('library.searchMore') %></a>
      </div>

      <% if (salvos.length === 0) { %>
        <p class="lista-vazia">
          <%- t('library.emptyState') %>
        </p>
      <% } %>

      <div class="grade-fichas">
        <% salvos.forEach(function (artigo) { %>
          <%- include('partials/ficha-artigo', { artigo, salvo: true }) %>
        <% }); %>
      </div>
    </section>
    </main>
  </div>

  <%- include('partials/modal-pdf') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="/js/pdf-preview.js"></script>
</body>
</html>
