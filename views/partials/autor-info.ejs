<button type="button" class="autor-info" data-abrir-perfil="<%= autorId %>">
  <% if (autorAvatar) { %>
    <img class="avatar-preview avatar-preview-pequeno" src="/usuarios/<%= autorId %>/foto" alt="<%= autorNome %>" />
  <% } else { %>
    <span class="avatar-preview avatar-preview-pequeno avatar-preview-vazio">
      <svg class="icone" viewBox="0 0 24 24"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 10.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-5.5"/></svg>
    </span>
  <% } %>
  <span class="autor-info-texto">
    <strong><%= autorNome %></strong>
    <% if (autorArea) { %><span class="autor-info-area"><%= autorArea %></span><% } %>
  </span>
</button>
