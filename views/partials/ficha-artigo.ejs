<%
  const link = artigo.doi ? ('https://doi.org/' + artigo.doi) : artigo.url;
  const resumoCompleto = artigo.abstract || '';
  const resumo = resumoCompleto.length > 280 ? resumoCompleto.slice(0, 280) + '…' : resumoCompleto;
  const readOnly = typeof somenteLeitura !== 'undefined' && somenteLeitura;
%>
<article class="ficha-artigo ja-salva" data-id="<%= artigo.id %>">
  <div class="cabecalho-ficha">
    <h3><%= artigo.title %></h3>
    <% if (artigo.year) { %><span class="ano"><%= artigo.year %></span><% } %>
  </div>
  <% if (artigo.authors) { %><p class="autores"><%= artigo.authors %></p><% } %>
  <% if (artigo.venue) { %><p class="veiculo"><%= artigo.venue %></p><% } %>
  <% if (resumo) { %><p class="resumo"><%= resumo %></p><% } %>
  <% if (link) { %><p class="link-artigo"><a href="<%= link %>" target="_blank" rel="noopener"><%= t('articles.openArticleLink') %></a></p><% } %>
  <% if (artigo.pdf_url) { %>
    <div class="acoes-pdf">
      <button
        class="botao secundario"
        type="button"
        data-acao="previa-pdf"
        data-pdf-url="<%= artigo.pdf_url %>"
        data-pdf-titulo="<%= artigo.title %>"
      >
        <svg class="icone" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        <%= t('articles.previewButton') %>
      </button>
      <% if (!readOnly) { %>
        <a class="botao secundario" href="/pdf-externo?url=<%= encodeURIComponent(artigo.pdf_url) %>&baixar=1" target="_blank" rel="noopener">
          <svg class="icone" viewBox="0 0 24 24"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 19h16"/></svg>
          <%= t('articles.downloadPdfButton') %>
        </a>
      <% } %>
    </div>
  <% } %>
  <% if (!readOnly) { %>
    <div class="acoes">
      <form class="remover" method="POST" action="/artigos/<%= artigo.id %>/remover">
        <button class="botao secundario" type="submit"><%= t('articles.removeButton') %></button>
      </form>
    </div>
  <% } %>
</article>
