<div id="modal-pdf" class="modal-pdf" style="display: none;">
  <div class="modal-pdf-fundo" id="modal-pdf-fundo"></div>
  <div class="modal-pdf-caixa">
    <div class="modal-pdf-topo">
      <strong id="modal-pdf-titulo"><%= t('pdfPreview.title') %></strong>
      <div class="navegacao-paginas" style="margin: 0;">
        <button class="botao secundario" type="button" id="modal-pagina-anterior">◀</button>
        <span id="modal-indicador-pagina"><%= t('pdfPreview.pageIndicator', { atual: 1, total: 1 }) %></span>
        <button class="botao secundario" type="button" id="modal-pagina-seguinte">▶</button>
      </div>
      <button class="botao secundario" type="button" id="modal-pdf-fechar"><%= t('pdfPreview.closeButton') %></button>
    </div>
    <div class="modal-pdf-corpo" id="modal-pdf-corpo">
      <p class="aviso-busca" id="modal-pdf-status"><%= t('pdfPreview.loading') %></p>
    </div>
  </div>
</div>
<script>
  window.I18N_PDF_PREVIEW = <%- JSON.stringify({
    title: t('pdfPreview.title'),
    pageIndicator: t('pdfPreview.pageIndicator', { atual: '{atual}', total: '{total}' }),
    loading: t('pdfPreview.loading'),
    blockedFallback: t('pdfPreview.blockedFallback'),
    openInNewTab: t('pdfPreview.openInNewTab'),
  }) %>;
</script>

