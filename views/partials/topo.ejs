<header class="topo">
  <a class="marca" href="/">
    <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg>
    Lumen
  </a>

  <form class="busca-catalogo" action="/artigos" method="GET">
    <svg class="icone" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="search" name="q" placeholder="Buscar no catálogo..." />
  </form>

  <nav>
    <a href="/" class="<%= paginaAtiva === 'inicio' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>
      Início
    </a>
    <a href="/artigos" class="<%= paginaAtiva === 'artigos' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h5"/></svg>
      Artigos
    </a>
    <a href="/leitura" class="<%= paginaAtiva === 'leitura' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 5c3-1.3 6-1.3 8 0 2-1.3 5-1.3 8 0v14c-3-1.3-6-1.3-8 0-2-1.3-5-1.3-8 0z"/><path d="M12 5v14"/></svg>
      Leitura
    </a>
    <span class="usuario">
      <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1.5-4 5-5.5 7-5.5s5.5 1.5 7 5.5"/></svg>
      Olá, <%= userName %>
    </span>
    <form method="POST" action="/logout">
      <button class="link" type="submit">
        <svg class="icone" viewBox="0 0 24 24"><path d="M15 4H6v16h9"/><path d="M10 12h10m0 0l-3-3m3 3l-3 3"/></svg>
        Sair
      </button>
    </form>
  </nav>
</header>
