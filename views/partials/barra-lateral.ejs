<aside class="barra-lateral">
  <nav>
    <a href="/" class="item-lateral <%= paginaAtiva === 'inicio' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>
      <%= t('sidebar.inicio') %>
    </a>
    <a href="/conta" class="item-lateral <%= paginaAtiva === 'conta' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 10.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-5.5"/><path d="M22 8v6"/></svg>
      <%= t('sidebar.conta') %>
    </a>
    <a href="/artigos" class="item-lateral <%= paginaAtiva === 'artigos' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h5"/></svg>
      <%= t('sidebar.artigos') %>
    </a>
    <a href="/leitura" class="item-lateral <%= paginaAtiva === 'leitura' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 5c3-1.3 6-1.3 8 0 2-1.3 5-1.3 8 0v14c-3-1.3-6-1.3-8 0-2-1.3-5-1.3-8 0z"/><path d="M12 5v14"/></svg>
      <%= t('sidebar.leitura') %>
    </a>
    <a href="/biblioteca" class="item-lateral <%= paginaAtiva === 'biblioteca' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 4v16M9 4v16M9 4c2 0 3 1 5 1s3-1 5-1v14c-2 0-3 1-5 1s-3-1-5-1"/></svg>
      <%= t('sidebar.biblioteca') %>
    </a>
    <a href="/codificacao" class="item-lateral <%= paginaAtiva === 'codificacao' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M20.59 13.41L11 3.83A2 2 0 009.59 3H4a1 1 0 00-1 1v5.59a2 2 0 00.59 1.41l9.58 9.58a2 2 0 002.83 0l4.59-4.59a2 2 0 000-2.83z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/></svg>
      <%= t('sidebar.codificacao') %>
    </a>
    <% if (isAdmin) { %>
      <a href="/admin" class="item-lateral <%= paginaAtiva === 'admin' ? 'ativo' : '' %>">
        <svg class="icone" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"/><path d="M9.5 12l2 2 3.5-3.5"/></svg>
        <%= t('sidebar.admin') %>
      </a>
    <% } %>
    <hr class="divisor-lateral" />
    <form method="POST" action="/logout" class="form-sair-lateral">
      <button type="submit" class="item-lateral">
        <svg class="icone" viewBox="0 0 24 24"><path d="M15 4H6v16h9"/><path d="M10 12h10m0 0l-3-3m3 3l-3 3"/></svg>
        <%= t('sidebar.sair') %>
      </button>
    </form>
    <div class="seletor-idioma-lateral">
      <%- include('seletor-idioma') %>
    </div>
  </nav>

  <div class="promo-lateral">
    <svg class="icone" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg>
    <p><%= t('sidebar.promoQuote') %></p>
    <span class="assinatura">— Lumen</span>
  </div>
</aside>
