<aside class="barra-lateral">
  <nav>
    <a class="logo-lateral" href="/">
      <img src="/images/logo-lumen.png" alt="Lumen" />
    </a>
    <%- include('seletor-idioma-compacto') %>
    <a href="/" class="item-lateral <%= paginaAtiva === 'inicio' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>
      <%= t('sidebar.inicio') %>
    </a>
    <a href="/conta" class="item-lateral <%= paginaAtiva === 'conta' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 10.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-5.5"/><path d="M22 8v6"/></svg>
      <%= t('sidebar.conta') %>
    </a>
    <a href="/artigos" class="item-lateral <%= paginaAtiva === 'artigos' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h5"/></svg>
      <%= t('sidebar.artigos') %>
    </a>
    <a href="/leitura" class="item-lateral <%= paginaAtiva === 'leitura' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 5c3-1.3 6-1.3 8 0 2-1.3 5-1.3 8 0v14c-3-1.3-6-1.3-8 0-2-1.3-5-1.3-8 0z"/><path d="M12 5v14"/></svg>
      <%= t('sidebar.leitura') %>
    </a>
    <a href="/biblioteca" class="item-lateral <%= paginaAtiva === 'biblioteca' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M4 4v16M9 4v16M9 4c2 0 3 1 5 1s3-1 5-1v14c-2 0-3 1-5 1s-3-1-5-1"/></svg>
      <%= t('sidebar.biblioteca') %>
    </a>
    <a href="/codificacao" class="item-lateral <%= paginaAtiva === 'codificacao' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M20.59 13.41L11 3.83A2 2 0 009.59 3H4a1 1 0 00-1 1v5.59a2 2 0 00.59 1.41l9.58 9.58a2 2 0 002.83 0l4.59-4.59a2 2 0 000-2.83z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/></svg>
      <%= t('sidebar.codificacao') %>
    </a>
    <a href="/formularios" class="item-lateral <%= paginaAtiva === 'formularios' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M9 3h6a2 2 0 012 2v14a2 2 0 01-2 2H9a2 2 0 01-2-2V5a2 2 0 012-2z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
      <%= t('sidebar.formularios') %>
    </a>
    <a href="/forum" class="item-lateral <%= paginaAtiva === 'forum' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
      <%= t('sidebar.forum') %>
    </a>
    <a href="/network" class="item-lateral <%= paginaAtiva === 'network' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"/><path d="M2 21v-1a6 6 0 016-6h2a6 6 0 016 6v1"/><circle cx="17" cy="7" r="2.5"/><path d="M21 21v-1a5.5 5.5 0 00-3.5-5.1"/></svg>
      <%= t('sidebar.network') %>
      <% if (solicitacoesAmizadePendentes > 0) { %><span class="badge-notificacao"><%= solicitacoesAmizadePendentes %></span><% } %>
    </a>
    <a href="/mensagens" class="item-lateral <%= paginaAtiva === 'mensagens' ? 'ativo' : '' %>">
      <svg class="icone" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
      <%= t('sidebar.messages') %>
      <% if (mensagensNaoLidas > 0) { %><span class="badge-notificacao"><%= mensagensNaoLidas %></span><% } %>
    </a>
    <details class="seletor-codigos item-notificacoes-lateral">
      <summary class="item-lateral">
        <svg class="icone" viewBox="0 0 24 24"><path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        <%= t('sidebar.notifications') %>
        <% if (notificacoesNaoLidas > 0) { %><span class="badge-notificacao"><%= notificacoesNaoLidas %></span><% } %>
      </summary>
      <div class="menu-codigos menu-notificacoes">
        <% if (notificacoesRecentes.length === 0) { %>
          <p class="trecho-sem-codigo" style="padding: 0.6rem;"><%= t('notifications.empty') %></p>
        <% } else { %>
          <% notificacoesRecentes.forEach(function (n) { %>
            <a href="/notificacoes/<%= n.id %>/abrir" class="item-menu-codigo item-notificacao <%= !n.read_at ? 'nao-lida' : '' %>">
              <% if (n.type === 'forum_reply') { %>
                <%= t('notifications.forumReply', { nome: n.ator_nome }) %>
              <% } else if (n.type === 'library_share') { %>
                <%= t('notifications.libraryShare', { nome: n.ator_nome }) %>
              <% } else if (n.type === 'friend_request') { %>
                <%= t('notifications.friendRequest', { nome: n.ator_nome }) %>
              <% } else if (n.type === 'friend_accepted') { %>
                <%= t('notifications.friendAccepted', { nome: n.ator_nome }) %>
              <% } %>
            </a>
          <% }); %>
        <% } %>
      </div>
    </details>
    <% if (isAdmin) { %>
      <a href="/admin" class="item-lateral <%= paginaAtiva === 'admin' ? 'ativo' : '' %>">
        <svg class="icone" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"/><path d="M9.5 12l2 2 3.5-3.5"/></svg>
        <%= t('sidebar.admin') %>
      </a>
    <% } %>
    <hr class="divisor-lateral" />
    <form method="POST" action="/logout" class="form-sair-lateral">
      <button type="submit" class="item-lateral">
        <svg class="icone" viewBox="0 0 24 24"><path d="M15 4H6v16h9"/><path d="M10 12h10m0 0l-3-3m3 3l-3 3"/></svg>
        <%= t('sidebar.sair') %>
      </button>
    </form>
  </nav>
</aside>
