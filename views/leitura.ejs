<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <title><%= t('reading.tabTitle') %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/cabecalho') %>

  <div class="corpo-app">
    <%- include('partials/barra-lateral', { paginaAtiva: 'leitura' }) %>

    <main>
    <%- include('partials/voltar-modulos') %>
    <p class="eyebrow-secao"><%= t('reading.eyebrow') %></p>
    <h2><%= t('reading.headingPrefix') %><span class="destaque-dourado">PDF</span><%= t('reading.headingSuffix') %></h2>
    <p class="subtitulo-documentos" style="margin-bottom: 1.3rem;">
      <%= t('reading.subtitle') %>
    </p>
    <div class="cartao">
      <form id="form-upload" class="form-upload-grade">
        <div class="campo campo-arquivo">
          <label><%= t('reading.fileLabel') %></label>
          <label for="arquivo-pdf" class="dropzone-arquivo" id="dropzone-arquivo">
            <svg class="icone" viewBox="0 0 24 24"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M20 16v3a2 2 0 01-2 2H6a2 2 0 01-2-2v-3"/></svg>
            <span id="dropzone-texto">
              <strong><%= t('reading.chooseFile') %></strong>
              <small><%= t('reading.dragHint') %></small>
            </span>
            <input type="file" id="arquivo-pdf" accept="application/pdf" required />
          </label>
        </div>
        <div class="campo">
          <label for="titulo-documento"><%= t('reading.titleLabel') %></label>
          <input type="text" id="titulo-documento" placeholder="<%= t('reading.titlePlaceholder') %>" required />
        </div>
        <div class="campo">
          <label for="artigo-vinculado"><%= t('reading.linkArticleLabel') %></label>
          <select id="artigo-vinculado">
            <option value=""><%= t('reading.linkArticleNone') %></option>
            <% meusArtigos.forEach(function (artigo) { %>
              <option value="<%= artigo.id %>"><%= artigo.title %></option>
            <% }); %>
          </select>
        </div>
        <button class="botao campo-botao-upload" type="submit">
          <svg class="icone" viewBox="0 0 24 24"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg>
          <%= t('reading.uploadButton') %>
        </button>
      </form>
      <p class="aviso-busca" id="status-upload"></p>
    </div>

    <section id="area-leitura" style="display: none; margin-top: 2.5rem;">
      <h2><%= t('reading.extractedTextHeading') %></h2>
      <div class="busca-form">
        <input type="text" id="busca-texto" placeholder="<%= t('reading.searchTextPlaceholder') %>" />
        <button class="botao secundario" type="button" id="botao-buscar-texto"><%= t('reading.searchButton') %></button>
      </div>
      <p class="aviso-busca" id="aviso-busca-texto"></p>

      <div class="navegacao-paginas">
        <button class="botao" type="button" id="botao-pagina-anterior"><%= t('reading.prevPage') %></button>
        <span id="indicador-pagina"><%= t('reading.pageIndicator', { atual: 1, total: 1 }) %></span>
        <button class="botao" type="button" id="botao-pagina-seguinte"><%= t('reading.nextPage') %></button>
      </div>

      <p class="aviso-busca" style="margin-top: 0.6rem;">
        <%= t('reading.selectionHint') %>
      </p>
      <div class="visor-texto-wrapper">
        <button class="botao botao-recorte-flutuante" type="button" id="botao-modo-recorte">
          <svg class="icone" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="3 3"/><circle cx="9" cy="9" r="1.5" fill="currentColor" stroke="none"/><path d="M21 15l-5-5L5 21"/></svg>
          <span id="texto-modo-recorte"><%= t('reading.markImageCropButton') %></span>
        </button>
        <div class="visor-texto" id="visor-texto"></div>
      </div>

      <div id="popup-marcar" class="popup-marcar" style="display: none;">
        <button class="botao tijolo" type="button" id="botao-marcar"><%= t('reading.markKeyExcerptButton') %></button>
      </div>

      <div id="popup-recorte" class="popup-marcar popup-recorte" style="display: none;">
        <img id="preview-recorte" alt="<%= t('reading.cropPreviewAlt') %>" />
        <textarea id="legenda-recorte" placeholder="<%= t('reading.commentPlaceholder') %>" maxlength="500" rows="2"></textarea>
        <div class="popup-recorte-acoes">
          <button class="botao secundario" type="button" id="botao-cancelar-recorte"><%= t('reading.cancelButton') %></button>
          <button class="botao tijolo" type="button" id="botao-salvar-recorte"><%= t('reading.saveCropButton') %></button>
        </div>
      </div>

      <h3 style="margin-top: 2rem;"><%= t('reading.currentExcerptsHeading') %></h3>
      <div id="lista-destaques-atual" class="lista-destaques"></div>
    </section>

    <section class="secao" style="margin-top: 3rem;">
      <div class="documentos-cabecalho">
        <div class="titulo-com-icone">
          <span class="icone-caixa">
            <svg class="icone" viewBox="0 0 24 24"><path d="M4 4v16M9 4v16M9 4c2 0 3 1 5 1s3-1 5-1v14c-2 0-3 1-5 1s-3-1-5-1"/></svg>
          </span>
          <div>
            <h2><%= t('reading.myDocumentsHeading') %></h2>
            <p class="subtitulo-documentos"><%= t('reading.myDocumentsSubtitle') %></p>
          </div>
        </div>
        <% if (meusDocumentos.length > 0) { %>
          <div class="documentos-controles">
            <div class="busca-catalogo busca-documentos-caixa">
              <svg class="icone" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input type="search" id="busca-documentos" placeholder="<%= t('reading.searchDocumentPlaceholder') %>" />
            </div>
            <select id="ordenar-documentos" class="controle-ordenar-select">
              <option value="recentes"><%= t('reading.sortRecent') %></option>
              <option value="antigos"><%= t('reading.sortOldest') %></option>
              <option value="nome"><%= t('reading.sortName') %></option>
            </select>
          </div>
        <% } %>
      </div>

      <% if (meusDocumentos.length === 0) { %>
        <p class="lista-vazia"><%= t('reading.emptyDocuments') %></p>
      <% } %>

      <div class="grade-documentos" id="grade-documentos">
        <% meusDocumentos.forEach(function (doc) { %>
          <article
            class="ficha-documento"
            data-titulo="<%= doc.title.toLowerCase() %>"
            data-timestamp="<%= new Date(doc.created_at.replace(' ', 'T') + 'Z').getTime() %>"
          >
            <div class="ficha-documento-cabecalho">
              <div class="ficha-documento-icone ficha-documento-icone-pdf">PDF</div>
              <a class="botao botao-trechos-card" href="/documentos/<%= doc.id %>/trechos.pdf" title="<%= t('reading.downloadExcerptsTitle') %>">
                <svg class="icone" viewBox="0 0 24 24"><path d="M6 2h9l5 5v13a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2z"/><path d="M14 2v5h5"/><path d="M8 13h8M8 17h5"/></svg>
                <%= t('reading.downloadExcerptsButton') %>
              </a>
            </div>
            <h3><%= doc.title %></h3>
            <% if (doc.article_title) { %><p class="veiculo"><%= t('reading.linkedTo', { title: doc.article_title }) %></p><% } %>
            <p class="autores">
              <%= t('reading.uploadedOn', { data: doc.dataFormatada }) %><% if (doc.tamanhoFormatado) { %> · <%= doc.tamanhoFormatado %><% } %>
              · <%= t('reading.excerptCount', { n: doc.destaques.length }) %>
            </p>

            <div class="acoes acoes-documento">
              <button
                class="botao"
                type="button"
                data-acao="visualizar-documento"
                data-documento-id="<%= doc.id %>"
                data-documento-titulo="<%= doc.title %>"
              >
                <svg class="icone" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                <%= t('reading.viewButton') %>
              </button>
              <a class="botao secundario botao-icone" href="/documentos/<%= doc.id %>/baixar" title="<%= t('reading.downloadOriginalTitle') %>">
                <svg class="icone" viewBox="0 0 24 24"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 19h16"/></svg>
              </a>
              <form
                method="POST"
                action="/documentos/<%= doc.id %>/remover"
                data-confirm="<%= t('reading.confirmRemoveDocument', { titulo: doc.title }) %>"
              >
                <button class="botao secundario botao-icone botao-perigo" type="submit" title="<%= t('reading.removeDocumentTitle') %>">
                  <svg class="icone" viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 13a2 2 0 002 2h6a2 2 0 002-2l1-13"/><path d="M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/></svg>
                </button>
              </form>
            </div>
          </article>

          <template id="trechos-doc-<%= doc.id %>">
            <div class="lista-destaques">
              <% doc.destaques.forEach(function (destaque) { %>
                <div class="destaque-item<%= destaque.type === 'imagem' ? ' destaque-item-imagem' : '' %>">
                  <% if (destaque.type === 'imagem') { %>
                    <img src="/destaques/<%= destaque.id %>/imagem" alt="<%= t('reading.markedCropAlt') %>" />
                    <% if (destaque.excerpt) { %><p class="legenda-recorte-item"><%= destaque.excerpt %></p><% } %>
                  <% } else { %>
                    <p>"<%= destaque.excerpt %>"</p>
                  <% } %>
                  <form
                    method="POST"
                    action="/destaques/<%= destaque.id %>/remover"
                    data-confirm="<%= t('reading.confirmRemoveExcerpt') %>"
                  >
                    <button class="botao secundario" type="submit"><%= t('reading.removeButton') %></button>
                  </form>
                </div>
              <% }); %>
            </div>
          </template>
        <% }); %>
      </div>
    </section>
    </main>
  </div>

  <div id="modal-confirmar" class="modal-pdf" style="display: none;">
    <div class="modal-pdf-fundo" id="modal-confirmar-fundo"></div>
    <div class="modal-confirmar-caixa">
      <svg class="icone modal-confirmar-icone" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a1 1 0 00.86 1.5h18.64a1 1 0 00.86-1.5L13.71 3.86a1 1 0 00-1.72 0z"/></svg>
      <p id="modal-confirmar-mensagem"></p>
      <div class="modal-confirmar-acoes">
        <button class="botao secundario" type="button" id="modal-confirmar-cancelar"><%= t('reading.confirmModalCancel') %></button>
        <button class="botao tijolo" type="button" id="modal-confirmar-remover"><%= t('reading.confirmModalRemove') %></button>
      </div>
    </div>
  </div>

  <script>
    window.I18N_LEITURA = <%- JSON.stringify({
      dropChangeHint: t('reading.dropChangeHint'),
      onlyPdfError: t('reading.onlyPdfError'),
      uploadingStatus: t('reading.uploadingStatus'),
      uploadErrorGeneric: t('reading.uploadErrorGeneric'),
      pdfLoadedStatus: t('reading.pdfLoadedStatus', { n: '{n}' }),
      pdfNoTextWarning: t('reading.pdfNoTextWarning'),
      pdfReadError: t('reading.pdfReadError'),
      loadingSavedPdf: t('reading.loadingSavedPdf'),
      loadFileErrorGeneric: t('reading.loadFileErrorGeneric'),
      viewingLoadedStatus: t('reading.viewingLoadedStatus', { titulo: '{titulo}', n: '{n}' }),
      noSelectableTextStatus: t('reading.noSelectableTextStatus'),
      loadSavedPdfError: t('reading.loadSavedPdfError'),
      pageIndicator: t('reading.pageIndicator', { atual: '{atual}', total: '{total}' }),
      searchingAllPages: t('reading.searchingAllPages'),
      noOccurrencesFound: t('reading.noOccurrencesFound'),
      foundOnPage: t('reading.foundOnPage', { pagina: '{pagina}', indice: '{indice}', total: '{total}' }),
      markExcerptError: t('reading.markExcerptError'),
      markExcerptConnectionError: t('reading.markExcerptConnectionError'),
      cancelCropButton: t('reading.cancelCropButton'),
      markImageCropButton: t('reading.markImageCropButton'),
      saveCropError: t('reading.saveCropError'),
      saveCropConnectionError: t('reading.saveCropConnectionError'),
      markedCropAlt: t('reading.markedCropAlt'),
    }) %>;
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="/js/leitura.js"></script>
</body>
</html>
