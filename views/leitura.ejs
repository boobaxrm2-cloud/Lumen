<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Leitura de PDF — Lumen</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/topo', { userName: userName || '', paginaAtiva: 'leitura' }) %>

  <main>
    <%- include('partials/voltar-modulos') %>
    <h2>Enviar PDF para leitura</h2>
    <div class="cartao">
      <form id="form-upload">
        <div class="campo">
          <label for="arquivo-pdf">Arquivo PDF</label>
          <input type="file" id="arquivo-pdf" accept="application/pdf" required />
        </div>
        <div class="campo">
          <label for="titulo-documento">Título do documento</label>
          <input type="text" id="titulo-documento" placeholder="Ex: nome do artigo" required />
        </div>
        <div class="campo">
          <label for="artigo-vinculado">Vincular a um artigo salvo (opcional)</label>
          <select id="artigo-vinculado">
            <option value="">— nenhum —</option>
            <% meusArtigos.forEach(function (artigo) { %>
              <option value="<%= artigo.id %>"><%= artigo.title %></option>
            <% }); %>
          </select>
        </div>
        <button class="botao" type="submit">Carregar PDF</button>
      </form>
      <p class="aviso-busca" id="status-upload"></p>
    </div>

    <section id="area-leitura" style="display: none; margin-top: 2.5rem;">
      <h2>Texto extraído</h2>
      <div class="busca-form">
        <input type="text" id="busca-texto" placeholder="Buscar palavra ou frase no texto..." />
        <button class="botao secundario" type="button" id="botao-buscar-texto">Buscar</button>
      </div>
      <p class="aviso-busca" id="aviso-busca-texto"></p>

      <div class="navegacao-paginas">
        <button class="botao secundario" type="button" id="botao-pagina-anterior">◀ Anterior</button>
        <span id="indicador-pagina">Página 1 de 1</span>
        <button class="botao secundario" type="button" id="botao-pagina-seguinte">Próxima ▶</button>
      </div>

      <p class="aviso-busca">Selecione um trecho com o mouse — um botão vai aparecer para marcar.</p>
      <div class="visor-texto" id="visor-texto"></div>

      <div id="popup-marcar" class="popup-marcar" style="display: none;">
        <button class="botao tijolo" type="button" id="botao-marcar">Marcar trecho-chave</button>
      </div>

      <h3 style="margin-top: 2rem;">Trechos-chave deste documento</h3>
      <div id="lista-destaques-atual" class="lista-destaques"></div>
    </section>

    <section class="secao" style="margin-top: 3rem;">
      <div class="documentos-cabecalho">
        <div>
          <h2>
            <svg class="icone" viewBox="0 0 24 24"><path d="M4 4v16M9 4v16M9 4c2 0 3 1 5 1s3-1 5-1v14c-2 0-3 1-5 1s-3-1-5-1"/></svg>
            Meus documentos
          </h2>
          <p class="subtitulo-documentos">Acesse os documentos que você já enviou.</p>
        </div>
        <% if (meusDocumentos.length > 0) { %>
          <div class="documentos-controles">
            <div class="busca-catalogo busca-documentos-caixa">
              <svg class="icone" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input type="search" id="busca-documentos" placeholder="Buscar documento..." />
            </div>
            <select id="ordenar-documentos" class="controle-ordenar-select">
              <option value="recentes">Mais recentes</option>
              <option value="antigos">Mais antigos</option>
              <option value="nome">Nome (A-Z)</option>
            </select>
          </div>
        <% } %>
      </div>

      <% if (meusDocumentos.length === 0) { %>
        <p class="lista-vazia">Nenhum PDF enviado ainda.</p>
      <% } %>

      <div class="grade-documentos" id="grade-documentos">
        <% meusDocumentos.forEach(function (doc) { %>
          <article
            class="ficha-documento"
            data-titulo="<%= doc.title.toLowerCase() %>"
            data-timestamp="<%= new Date(doc.created_at.replace(' ', 'T') + 'Z').getTime() %>"
          >
            <div class="ficha-documento-icone">
              <svg class="icone" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/></svg>
            </div>
            <h3><%= doc.title %></h3>
            <% if (doc.article_title) { %><p class="veiculo">Vinculado a: <%= doc.article_title %></p><% } %>
            <p class="autores">
              Enviado em <%= doc.dataFormatada %><% if (doc.tamanhoFormatado) { %> · <%= doc.tamanhoFormatado %><% } %>
              · <%= doc.destaques.length %> trecho(s)
            </p>

            <div class="acoes">
              <button
                class="botao"
                type="button"
                data-acao="visualizar-documento"
                data-documento-id="<%= doc.id %>"
                data-documento-titulo="<%= doc.title %>"
              >
                <svg class="icone" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                Visualizar
              </button>
              <a class="botao secundario" href="/documentos/<%= doc.id %>/baixar">
                <svg class="icone" viewBox="0 0 24 24"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 19h16"/></svg>
                Baixar
              </a>
              <form method="POST" action="/documentos/<%= doc.id %>/remover">
                <button class="botao secundario" type="submit">Remover</button>
              </form>
            </div>
          </article>

          <template id="trechos-doc-<%= doc.id %>">
            <div class="lista-destaques">
              <% doc.destaques.forEach(function (destaque) { %>
                <div class="destaque-item">
                  <p>"<%= destaque.excerpt %>"</p>
                  <form method="POST" action="/destaques/<%= destaque.id %>/remover">
                    <button class="botao secundario" type="submit">Remover</button>
                  </form>
                </div>
              <% }); %>
            </div>
          </template>
        <% }); %>
      </div>
    </section>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="/js/leitura.js"></script>
</body>
</html>
